{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gym-log",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is a static asset or the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TIMER", "class_name": "TimerDO" }]
  },
  // Declarative Durable Object setup (replaces "migrations"); SQLite is required on the Free plan.
  "exports": {
    "TimerDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    // Contact for the push services (RFC 8292). The owner may switch it to a mailto: address.
    "VAPID_SUBJECT": "https://gym-log.fs-personal.workers.dev",
    "VAPID_PUBLIC_KEY": "BF1U6GE8ggWWETHbXKJovkA8fmp5VZFvzVA0AIqBCUO8IdPt96glqiLaGDo5h5o8qm0RgXBO3qiETeTtkhHOXhA"
  },
  "secrets": { "required": ["VAPID_PRIVATE_KEY"] }
}
